# PTM server-side environment variables.
#
# ALL of these are read ONLY by Vercel serverless functions under api/.
# Never prefix any of them with REACT_APP_ — anything with that prefix is
# bundled into the public React app and would leak the value to every
# visitor's browser. Copy this file to .env.local for local development
# (gitignored already) and set the same names in the Vercel project's
# Environment Variables settings for Preview/Production.
#
# Local development note: `npm start` alone serves only the React app. Run
# `npm run dev:api` in a second terminal to serve the api/ functions on
# port 3001 (CRA proxies /api/* to it — see "proxy" in package.json).

# --- Ask Path (ASK PATH-001) ------------------------------------------------

# Required for Ask Path. Without this set, Ask Path degrades gracefully
# (returns a clear "not configured yet" message instead of erroring).
OPENAI_API_KEY=

# Optional. Overrides the default model (see api/_lib/openaiClient.js).
OPENAI_MODEL=gpt-5.6-terra

# --- Data foundation / Partner Network admin (DATA-001) ---------------------
# Without these four set, the site still builds and runs: public forms fall
# back to Formspree email delivery and /partner-network/admin shows an
# explicit "backend not configured" state instead of records.

# Supabase project URL (Project Settings → API → Project URL),
# e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (Project Settings → API → service_role).
# SERVER-ONLY and highly sensitive: it bypasses Row Level Security. It must
# never appear in src/, in anything REACT_APP_-prefixed, or in a client
# bundle. The anon/public key is deliberately NOT used anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to sign admin session cookies (HMAC-SHA256).
# Generate one with:  openssl rand -base64 48
# Rotating it signs every admin out immediately.
ADMIN_SESSION_SECRET=

# Comma-separated allowlist of admin email addresses. Only these accounts
# (which must also exist as users in Supabase Auth) can sign in to
# /partner-network/admin. Removing an address revokes access immediately.
ADMIN_EMAILS=
