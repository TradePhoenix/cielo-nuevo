# Ask Path (ASK PATH-001) — server-side environment variables.
#
# These are read ONLY by api/ask-path.js (a Vercel serverless function).
# Never prefix these with REACT_APP_ — anything with that prefix is bundled
# into the public React app and would leak the key to every visitor's
# browser. Copy this file to .env.local for local development (gitignored
# already) and set the same names in the Vercel project's Environment
# Variables settings for Preview/Production.

# Required. Your OpenAI API secret key. Without this set, Ask Path
# degrades gracefully (returns a clear "not configured yet" message
# instead of erroring) rather than crashing.
OPENAI_API_KEY=

# Optional. Overrides the default model (see api/_lib/openaiClient.js).
# Any model available on your OpenAI account that supports the Responses
# API should work; the default was chosen for cost-conscious,
# customer-facing conversation.
OPENAI_MODEL=gpt-5.6-terra
